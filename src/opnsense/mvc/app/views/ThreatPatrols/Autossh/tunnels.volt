<script>
    $(document).ready(function () {
        $("#{{ formGridTunnel['table_id'] }}").UIBootgrid({
            search: '/api/autossh/tunnels/searchTunnel/',
            get: '/api/autossh/tunnels/getTunnel/',
            set: '/api/autossh/tunnels/setTunnel/',
            add: '/api/autossh/tunnels/addTunnel/',
            del: '/api/autossh/tunnels/delTunnel/',
            toggle: '/api/autossh/tunnels/toggleTunnel/',
            info: '/api/autossh/tunnels/info/'
        });

        $("#{{ formGridKey['table_id'] }}").UIBootgrid({
            search: '/api/autossh/keys/searchKey/',
            get: '/api/autossh/keys/getKey/',
            set: '/api/autossh/keys/setKey/',
            add: '/api/autossh/keys/addKey/',
            del: '/api/autossh/keys/delKey/',
            info: '/api/autossh/keys/info/'
        });

        /**
         * base_apply_button only emits the markup; this is what fills in its
         * label and binds the click to data-endpoint.
         */
        $("#reconfigureAct").SimpleActionButton();

        /**
         * The algorithm fields are offered to the remote in the order listed,
         * so they are rendered as tokenizers rather than plain multi-selects.
         */
        formatTokenizersUI();

        /**
         * Key material is generated by the backend when the record is created;
         * the type cannot be changed afterwards.
         */
        $('#{{ formGridKey["edit_dialog_id"] }}').on('opnsense_bootgrid_mapped', function (e, actionType) {
            $("#key\\.type").prop("disabled", actionType === 'edit');
            $("#key\\.type").selectpicker('refresh');
        });
    });
</script>

<ul class="nav nav-tabs" data-tabs="tabs" id="maintabs">
    <li class="active"><a data-toggle="tab" href="#tunnels">{{ lang._('Tunnels') }}</a></li>
    <li><a data-toggle="tab" href="#keys">{{ lang._('Keys') }}</a></li>
</ul>

<div class="tab-content content-box">
    <div id="tunnels" class="tab-pane fade in active">
        {{ partial('layout_partials/base_bootgrid_table', formGridTunnel) }}
        <div class="col-md-12">
            <div class="alert alert-info" role="alert">
                {{ lang._('Changes take effect when you press Apply. Only tunnels whose configuration actually changed are restarted.') }}
                {{ lang._('Use the info button on a tunnel to review the ssh host keys it has recorded.') }}
            </div>
        </div>
    </div>
    <div id="keys" class="tab-pane fade">
        {{ partial('layout_partials/base_bootgrid_table', formGridKey) }}
        <div class="col-md-12">
            <div class="alert alert-info" role="alert">
                {{ lang._('Key pairs are generated on this firewall; the private key never leaves it. Use the info button to copy the public key, including its restrictions, into the authorized_keys file of the remote user.') }}
            </div>
        </div>
    </div>
</div>

{{ partial('layout_partials/base_apply_button', {'data_endpoint': '/api/autossh/service/reconfigure', 'data_service_widget': 'autossh'}) }}

{{ partial("layout_partials/base_dialog", ['fields': formDialogTunnel, 'id': formGridTunnel['edit_dialog_id'], 'label': lang._('Edit tunnel')]) }}
{{ partial("layout_partials/base_dialog", ['fields': formDialogKey, 'id': formGridKey['edit_dialog_id'], 'label': lang._('Edit key')]) }}
