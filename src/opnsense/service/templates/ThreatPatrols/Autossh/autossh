#
# /etc/rc.conf.d/autossh
#
# This file is automatically generated, do not manually edit as changes *will* be lost!
#

autossh_enable="YES"

# NB: loglevel 4 is the minimum that emits the "connection ok" lines the
# connection status page uses for its health check.
autossh_loglevel=4

# autossh binds a local monitoring socket pair; these bounds are halved and
# doubled by the rc script so that only even ports are handed out.
autossh_monitor_port_min=60000
autossh_monitor_port_max=65000

# NB: must be 60 seconds or less for the health check to stay meaningful.
autossh_monitor_poll_interval=60

autossh_configfile="/usr/local/etc/autossh/autossh.conf"
